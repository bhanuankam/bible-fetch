#!/usr/bin/env python3

import sys
from typing import Optional, Tuple, TYPE_CHECKING
import argparse
import requests
from unidecode import unidecode
import urllib.parse

if TYPE_CHECKING:
    from bs4.element import Tag
    from bs4 import BeautifulSoup
else:
    try:
        from bs4.element import Tag
        from bs4 import BeautifulSoup
    except (ImportError, ModuleNotFoundError):
        from bs4 import BeautifulSoup, Tag


def parse_args() -> Tuple[str, str, bool, bool]:
    """Parse command line arguments for bible reference fetching.

    Returns:
        Tuple of (reference, version, show_verse_numbers, use_ascii)
    """
    default_version = "NIV"
    parser = argparse.ArgumentParser(
        description="Fetch Bible references from biblegateway.com"
    )
    parser.add_argument("reference", nargs="*", help="bible reference")
    parser.add_argument(
        "--version",
        nargs="?",
        help="translation (e.g. NIV, NLT)",
        default=default_version,
    )
    parser.add_argument(
        "--verse-numbers",
        action="store_true",
        default=False,
        help="print verse numbers (hidden by default)",
    )
    parser.add_argument(
        "--ascii",
        action="store_true",
        default=False,
        help="translate Unicode to ASCII (useful on Windows)",
    )
    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(1)
    args = parser.parse_args()
    return (
        " ".join(args.reference),
        args.version,
        args.verse_numbers,
        args.ascii,
    )


def get_soup(query: str, version: str) -> Optional[BeautifulSoup]:
    """Fetch and parse HTML from BibleGateway.

    Args:
        query: The Bible reference to search for
        version: The Bible translation version (e.g., NIV, NLT)

    Returns:
        BeautifulSoup object if successful, None otherwise
    """
    try:
        query = urllib.parse.quote_plus(query)
        url = f"https://www.biblegateway.com/passage/?search={query}&version={version}"
        response = requests.get(url, timeout=10)
        response.raise_for_status()
        return BeautifulSoup(response.text, "html.parser")
    except requests.RequestException as e:
        print(f"Error fetching passage: {e}", file=sys.stderr)
        return None


def clean(tag: Tag, show_verse_numbers: bool) -> None:
    """Remove unwanted HTML elements from the passage tag.

    Args:
        tag: BeautifulSoup Tag to clean
        show_verse_numbers: Whether to keep verse number elements
    """
    for t in tag.find_all("sup"):
        if show_verse_numbers and "versenum" in t.get("class", []):
            continue
        t.decompose()
    if not show_verse_numbers:
        for t in tag.find_all(class_="chapternum"):
            t.decompose()
    for t in tag.find_all(class_="surface"):
        t.decompose()


def render(tag: Tag, show_verse_numbers: bool) -> str:
    """Render a cleaned passage tag as plain text.

    Args:
        tag: BeautifulSoup Tag to render
        show_verse_numbers: Whether to keep verse number elements

    Returns:
        Plain text rendering of the passage
    """
    clean(tag, show_verse_numbers)
    text = ""
    for t in tag.descendants:
        if isinstance(t, str):
            text += t
        elif t.name == "br":
            text += "\n"
    return text


def get_passages(soup: BeautifulSoup, show_verse_numbers: bool) -> Optional[str]:
    """Extract and format all passages from the parsed HTML.

    Args:
        soup: BeautifulSoup object containing the parsed HTML
        show_verse_numbers: Whether to include verse numbers

    Returns:
        Formatted passage text, or None if no passages found
    """
    passages = soup.find_all(class_="passage-table")
    if not passages:
        return None
    text = ""
    for p in passages:
        passage_text = get_passage(p, show_verse_numbers)
        if passage_text:
            text += passage_text + "\n\n"
    return text.replace('  ', ' ') if text else None


def get_passage(soup: Tag, show_verse_numbers: bool) -> Optional[str]:
    """Extract a single passage from a passage table.

    Args:
        soup: BeautifulSoup Tag containing a passage table
        show_verse_numbers: Whether to include verse numbers

    Returns:
        Formatted passage text, or None if not found
    """
    root = soup.find(class_="result-text-style-normal")
    if root is None:
        return None
    return "\n\n".join(render(t, show_verse_numbers) for t in root.select("p, div.poetry p"))


def main() -> None:
    """Main entry point for the bible-fetch tool."""
    query, version, show_verse_numbers, use_ascii = parse_args()
    soup = get_soup(query, version)

    if soup is None:
        sys.exit(1)

    passage = get_passages(soup, show_verse_numbers)

    if passage is None:
        return

    passage = passage.strip()
    if use_ascii:
        passage = unidecode(passage)

    print(passage)


if __name__ == "__main__":
    main()
